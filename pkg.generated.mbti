pub fn WeightedProbabilityEnsemble::predict(Self, Array[Double]) -> Double
pub fn WeightedProbabilityEnsemble::reset(Self) -> Unit
pub fn WeightedProbabilityEnsemble::update(Self, Array[Double], Double, learning_rate? : Double) -> Unit
pub fn WeightedProbabilityEnsemble::weights(Self) -> Array[Double]

// Type aliases

// Traits
pub trait OnlineLearner {
  fn update(Self, Array[Double], Double) -> Unit
  fn predict(Self, Array[Double]) -> Double
}

pub trait Snapshot {
  fn to_bytes(Self) -> Bytes
  fn from_bytes(Self, Bytes) -> Bool
}
